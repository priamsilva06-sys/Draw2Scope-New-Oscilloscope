        add('Triangle','triangle','🔺',(nCorners>=1&&nCorners<=4?0.85:0.2)*(cvR>0.03?0.8:0.4)*(yExtrema<=3?0.85:0.3)*(straightness<0.65?0.85:0.4)*(sharpTurns>=1?0.8:0.4));
        add('Square','square','⬜',(nCorners>=2&&nCorners<=5?0.85:0.15)*(aspect<1.5?0.85:0.3)*(cvR>0.03?0.7:0.35)*(yExtrema<=3?0.85:0.3)*(straightness<0.7?0.8:0.3));
        if(selfIntersect)add('Limacon','limacon','🐚',(cvR>0.06?0.8:0.3)*(nCorners<=5?0.7:0.2)*(smoothness>0.1?0.6:0.2)*(crossCount>=1?0.75:0.4)*(aspect<1.7?0.7:0.3));
        if(selfIntersect)add('Pretzel','pretzel','🥨',(crossCount>=2?0.7:crossCount===1?0.4:0.15)*(smoothness>0.15?0.7:0.3)*(straightness<0.6?0.7:0.3));
        add('Cardioid','cardioid','❤️',(cvR>0.03?0.7:0.2)*(nCorners<=5?0.65:0.15)*(smoothness>0.15?0.6:0.15)*(aspect<1.7?0.65:0.2)*(centroidOffset>0.005?0.8:0.3)*(selfIntersect?0.6:0.85));
        add('Stick Figure','stickfigure','🤖',(selfIntersect?0.5:0.2)*(sharpTurns>=2?0.5:0.2)*(concavity>0.05?0.4:0.15));
      }
      cands.sort((a,b)=>b.score-a.score);
      const topScore = cands.length > 0 ? cands[0].score : 0;
      // Show shapes that are reasonably close — generous to surface weird-shape suggestions
      let result = cands.filter(c => c.score >= 0.12 && c.score >= topScore * 0.28).slice(0, 6);
      if (result.length === 0 && topScore >= 0.10) result = cands.slice(0, 1);
      return result;
    }

    // Rebuild the scope/audio trace from all committed strokes.
    // The Draw Box keeps every stroke (no connectors drawn); the scope
    // traces the strokes in order, with straight jumps between them.
    function rebuildScopePathFromStrokes() {
      if (!drawStrokes || drawStrokes.length === 0) {
        currentPath = [];
        pathIsClosed = false;
        updateAudioBuffer();
        return;
      }
      const flat = [];
      for (const st of drawStrokes) {
        if (!st) continue;
        for (const p of st) flat.push({ x: p.x, y: p.y });
      }
      if (flat.length < 2) {
        currentPath = flat;
        pathIsClosed = false;
        updateAudioBuffer();
        return;
      }
      const fp = flat[0], lp = flat[flat.length - 1];
      let minX = Infinity, maxX = -Infinity, minY = Infinity, maxY = -Infinity;
      for (const p of flat) {
        if (p.x < minX) minX = p.x;
        if (p.x > maxX) maxX = p.x;
        if (p.y < minY) minY = p.y;
        if (p.y > maxY) maxY = p.y;
      }
      const diagLen = Math.hypot(maxX - minX, maxY - minY) || 0.001;
      const endGap = Math.hypot(fp.x - lp.x, fp.y - lp.y);
      pathIsClosed = endGap < diagLen * 0.15 || (autoClose && flat.length > 3);
      if (pathIsClosed && endGap < 0.005) flat.pop();
      currentPath = resamplePath(flat, 512, pathIsClosed);
      updateAudioBuffer();
    }

    function applyPerfectShape(shapeName) {
      if (!drawStrokes || drawStrokes.length === 0) return;
      const lastStroke = drawStrokes[drawStrokes.length - 1];
      if (!lastStroke || lastStroke.length < 3) return;
      const newPath = generatePerfectShape(shapeName);
      if (!newPath || newPath.length === 0) return;
      // Center the perfect shape on the last-drawn stroke, replacing only it.
      let sumX = 0, sumY = 0;
      lastStroke.forEach(p => { sumX += p.x; sumY += p.y; });
      const dcx = sumX / lastStroke.length, dcy = sumY / lastStroke.length;
      let pSumX = 0, pSumY = 0;
      newPath.forEach(p => { pSumX += p.x; pSumY += p.y; });
      const pcx = pSumX / newPath.length, pcy = pSumY / newPath.length;
      const dx = dcx - pcx, dy = dcy - pcy;
      const shifted = newPath.map(p => ({ x: p.x + dx, y: p.y + dy }));
      const fp = shifted[0], lp = shifted[shifted.length - 1];
      if (Math.hypot(fp.x - lp.x, fp.y - lp.y) < 0.005) shifted.pop();
      drawStrokes[drawStrokes.length - 1] = shifted;
      rebuildScopePathFromStrokes();
      drawDrawCanvas();
    }

