        cv.style.cssText = 'width:100%;height:90px;background:#000;border:1px solid #223322;border-radius:4px;';
        const ctx = cv.getContext('2d');
        ctx.strokeStyle = '#00ff9f';
        ctx.lineWidth = 1.5;
        ctx.shadowColor = '#00ff9f';
        ctx.shadowBlur = 4;
        ctx.beginPath();
        const path = lissajousPath(a, b, Math.PI / 2);
        for (let i = 0; i < path.length; i++) {
          const px = 55 + path[i].x * 48;
          const py = 45 - path[i].y * 38;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.closePath();
        ctx.stroke();
        const lb = document.createElement('div');
        lb.style.cssText = 'color:#88cc88;font-size:0.8rem;margin-top:4px;';
        lb.textContent = a + ':' + b;
        card.appendChild(cv);
        card.appendChild(lb);
        card.title = 'Load ' + a + ':' + b + ' to scope';
        card.addEventListener('click', function() {
          const full = lissajousPath(a, b, Math.PI / 2);
          drawStrokes = [full];
          rebuildScopePathFromStrokes();
          drawDrawCanvas();
          closeLissajousGrid();
        });
        card.addEventListener('mouseenter', function() { card.style.borderColor = '#00ff9f'; });
