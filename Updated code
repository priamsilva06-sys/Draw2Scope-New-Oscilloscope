  <script src="src/doodal-scope.js?v=1"></script>
  <script>
    // ==================== VARIABLES ====================
    let drawCanvas, drawCtx;
    let scopeCanvas;
    
    // Doodal CRT renderer state — exact dood.al/oscilloscope pipeline (src/doodal-scope.js)
    let doodalActive = false;
    const DOODAL_BUFFER = 1024;
    // Live display controls — same fields and semantics as dood.al's `controls`.
    // Fixed at dood.al defaults except persistence/exposure (sliders) and sweepOn.
    const doodal = {
      swapXY: false,
      sweepOn: false,
      sweepMsDiv: 1,
      sweepTriggerValue: 0,
      signalGeneratorOn: false,
      mainGain: 0.0,
      exposureStops: 0.0,
      audioVolume: 1.0,
      hue: 125,
      freezeImage: false,
      disableFilter: false,
      invertXY: false,
      grid: true,
      persistence: 0
    };
    let doodalLineSize = 0.015; // dood.al default uSize (trace-width slider scales around it)
    // Scope sample buffers (dood.al processes 1024-sample audio blocks, Lanczos x6)
    let scopeX = new Float32Array(DOODAL_BUFFER);
    let scopeY = new Float32Array(DOODAL_BUFFER);
    let scopeOldX = new Float32Array(DOODAL_BUFFER);
    let scopeOldY = new Float32Array(DOODAL_BUFFER);
    let scopeSmX = null, scopeSmY = null; // allocated after Filter.init
    let sweepPosition = -1;
    let belowTrigger = false;

    // Audible signal master (speaker-side only — the scope taps pre-volume samples,
    // same as dood.al's scopeNode sitting before its audioVolumeNode).
    const AUDIBLE_MASTER = 0.8;
    
   let currentPath = [];
   let strokePoints = [];
   let isDrawing = false;
    // All committed freehand strokes (each stroke = array of {x,y}).
    // Draw Box renders every stroke; the scope traces their concatenation.
    // Only the Clear button / 'C' key empties this — starting a new stroke never does.
    let drawStrokes = [];

    let currentFreq = 60.0;
    let sweepMode = false;
    let oscillateMode = false;
    let autoClose = false;
    let soundEnabled = false;
    
    let audioCtx = null;
    let scriptNode = null;
    let gainNode = null;
    
    // Display parameters (updated from sliders; scope look itself is dood.al's pipeline)
    let traceWidth = 1.8;
    let drawLineWidth = 2.5;  // stroke width while drawing (user adjustable)
    let rotation = 0;       // static angle in radians
    let rotateFreq = 0;     // continuous rotation speed in Hz (new)
    let scaleVal = 1.0;
    let offsetX = 0;
    let offsetY = 0;
    
    let animationRunning = false;
    
    // High-resolution seamless audio tables (resampled from drawing for click-free looping)
    let audioX = new Float32Array(4096);
    let audioY = new Float32Array(4096);
    
    // Persistent phase accumulator for sample-accurate, glitch-free audio
    let audioPhase = 0;
    let audioRotatePhase = 0;   // for rotateFreq (supports negative values for direction)
    let audioOscPhase = 0;      // unbounded accumulator for PERFECTLY smooth sinusoidal oscillation (no modulo jumps)
    
    let pathIsClosed = false;
    
    // ==================== MICROPHONE INPUT ====================
    let micEnabled = false;
    let micStream = null;
    let micAnalyser = null;
    let micTimeData = null;
    let micTimeDataR = null; // right channel for true stereo input
    let micPhase = 0; // stereo phase offset (radians) for mono→stereo conversion
    let micIsStereo = false; // true if mic input has 2 channels
    let lastMicLissajous = null; // last captured normalized Lissajous points (for freeze-to-draw-box)
    
    // ==================== HILBERT TRANSFORM VIA OVERLAP-SAVE FFT ====================
    // Computes a frequency-independent 90° phase shift (quadrature) of the mic
    // input. Uses FFT (for perfect phase + unity magnitude across all frequencies)
    // with overlap-save (previous frame provides context) and edge-skipping in the
    // draw code (to eliminate circular-convolution artifacts at buffer boundaries).
    //
    // The FFT approach gives perfect magnitude (unlike FIR which attenuates low
    // frequencies, causing "angular" Lissajous shapes). Edge artifacts from the
    // FFT's periodic assumption are pushed into the overlap region and skipped.
    let fftRe = new Float32Array(4096);
    let fftIm = new Float32Array(4096);
    let micQ = new Float32Array(2048);  // quadrature (90°-shifted) output
    let micI = new Float32Array(2048);  // in-phase (DC-blocked) output
    let micPrevBlock = new Float32Array(2048); // previous frame's DC-blocked data
    let micDCPrevX = 0; // DC blocker: previous input sample
    let micDCPrevY = 0; // DC blocker: previous output sample
    
    function fft(re, im, inverse) {
      const n = re.length;
      for (let i = 1, j = 0; i < n; i++) {
        let bit = n >> 1;
        for (; j & bit; bit >>= 1) j ^= bit;
        j ^= bit;
        if (i < j) {
          let tr = re[i]; re[i] = re[j]; re[j] = tr;
          let ti = im[i]; im[i] = im[j]; im[j] = ti;
        }
      }
      for (let len = 2; len <= n; len <<= 1) {
        const ang = (inverse ? 2 : -2) * Math.PI / len;
        const wRe = Math.cos(ang), wIm = Math.sin(ang);
        for (let i = 0; i < n; i += len) {
          let curRe = 1, curIm = 0;
          for (let j = 0; j < len / 2; j++) {
            const uRe = re[i + j], uIm = im[i + j];
            const vRe = re[i + j + len/2] * curRe - im[i + j + len/2] * curIm;
            const vIm = re[i + j + len/2] * curIm + im[i + j + len/2] * curRe;
            re[i + j] = uRe + vRe; im[i + j] = uIm + vIm;
            re[i + j + len/2] = uRe - vRe; im[i + j + len/2] = uIm - vIm;
            const newRe = curRe * wRe - curIm * wIm;
            curIm = curRe * wIm + curIm * wRe;
            curRe = newRe;
          }
        }
      }
      if (inverse) {
        for (let i = 0; i < n; i++) { re[i] /= n; im[i] /= n; }
      }
    }
    
    // Compute quadrature (Hilbert transform) of the input buffer via overlap-save FFT.
    // Processes a 2N buffer [previous frame | current frame] and extracts the
    // current N samples. The previous frame provides context so the FFT doesn't
    // see a hard discontinuity at the start of the current frame.
    // A DC blocker removes any mic DC offset that would skew the Lissajous pattern.
    function computeHilbertFFT(input, N) {
      const N2 = N * 2;
      if (fftRe.length !== N2) {
        fftRe = new Float32Array(N2);
        fftIm = new Float32Array(N2);
        micQ = new Float32Array(N);
        micI = new Float32Array(N);
        micPrevBlock = new Float32Array(N);
      }
      const re = fftRe, im = fftIm;
      
      // First half = previous frame's DC-blocked data (provides overlap context)
      for (let i = 0; i < N; i++) {
        re[i] = micPrevBlock[i];
        im[i] = 0;
      }
      
      // Second half = current frame's DC-blocked data
      const R = 0.999;
      for (let i = 0; i < N; i++) {
        const x = input[i];
        const y = x - micDCPrevX + R * micDCPrevY;
        micDCPrevX = x;
        micDCPrevY = y;
        re[N + i] = y;
        im[N + i] = 0;
        micI[i] = y;        // save DC-blocked in-phase for drawing
        micPrevBlock[i] = y; // save for next frame's overlap
      }
      
      // FFT, apply Hilbert transform (multiply positive freqs by -j, negative by +j)
      fft(re, im, false);
      re[0] = 0; im[0] = 0;
      re[N2/2] = 0; im[N2/2] = 0;
      for (let k = 1; k < N2/2; k++) {
        const tr = im[k]; const ti = -re[k];
        re[k] = tr; im[k] = ti;
        const tr2 = -im[N2-k]; const ti2 = re[N2-k];
        re[N2-k] = tr2; im[N2-k] = ti2;
      }
      fft(re, im, true);
      
      // Extract the current frame's quadrature from the second half
      for (let i = 0; i < N; i++) micQ[i] = re[N + i];
    }
    
    // ==================== HELPER FUNCTIONS ====================
    function getPointerPos(e, canvas) {
      const rect = canvas.getBoundingClientRect();
      let clientX, clientY;
      if (e.touches && e.touches.length > 0) {
        clientX = e.touches[0].clientX;
        clientY = e.touches[0].clientY;
      } else {
        clientX = e.clientX;
        clientY = e.clientY;
      }
      return {
        x: clientX - rect.left,
        y: clientY - rect.top
      };
    }
    
    function getNormPoint(pixelX, pixelY, canvasW, canvasH) {
      // Map to -1..1 with Y positive UP (matches visual expectation)
      const nx = ((pixelX / canvasW) - 0.5) * 2;
      const ny = (0.5 - (pixelY / canvasH)) * 2;
      return { x: nx, y: ny };
    }
    
    function getBasePos(phase) {
      if (!currentPath || currentPath.length === 0) return { x: 0, y: 0 };
      if (currentPath.length === 1) return currentPath[0];
      const N = currentPath.length;
      if (pathIsClosed) {
        let idx = phase * N;
        let i = Math.floor(idx) % N;
        let frac = idx - Math.floor(idx);
        const p1 = currentPath[i];
        const p2 = currentPath[(i + 1) % N];
        return { x: p1.x * (1 - frac) + p2.x * frac, y: p1.y * (1 - frac) + p2.y * frac };
      }
      let idx = phase * (N - 1);
      let i = Math.floor(idx);
      let frac = idx - i;
      if (i >= N - 1) return currentPath[N - 1];
      const p1 = currentPath[i];
      const p2 = currentPath[i + 1];
      return { x: p1.x * (1 - frac) + p2.x * frac, y: p1.y * (1 - frac) + p2.y * frac };
    }
    
    // ==================== SEAMLESS AUDIO WAVEFORM (fixes popping) ====================
    function updateAudioBuffer() {
      const TABLE_SIZE = 4096;
      audioX = new Float32Array(TABLE_SIZE);
      audioY = new Float32Array(TABLE_SIZE);
      
      if (!currentPath || currentPath.length < 2) return;
      
      for (let i = 0; i < TABLE_SIZE; i++) {
        const ph = pathIsClosed ? i / TABLE_SIZE : i / (TABLE_SIZE - 1);
        const p = getBasePos(ph);
        audioX[i] = p.x;
        audioY[i] = p.y;
      }
      
      if (pathIsClosed) {
        audioX[TABLE_SIZE - 1] = audioX[0];
        audioY[TABLE_SIZE - 1] = audioY[0];
        const SMOOTH = 5;
        for (let k = 1; k <= SMOOTH; k++) {
          const w = k / (SMOOTH + 1);
          const endIdx = TABLE_SIZE - k;
          const startIdx = k - 1;
          audioX[endIdx] = audioX[endIdx] * (1 - w) + audioX[startIdx] * w;
          audioY[endIdx] = audioY[endIdx] * (1 - w) + audioY[startIdx] * w;
        }
      }
    }
    
    function getAudioBasePos(phase) {
      const TABLE_SIZE = audioX.length;
      if (TABLE_SIZE === 0 || currentPath.length < 2) return { x: 0, y: 0 };
      
      if (pathIsClosed) {
        let idx = phase * TABLE_SIZE;
        let i = Math.floor(idx) % TABLE_SIZE;
        let frac = idx - Math.floor(idx);
        const ni = (i + 1) % TABLE_SIZE;
        const x = audioX[i] * (1 - frac) + audioX[ni] * frac;
        const y = audioY[i] * (1 - frac) + audioY[ni] * frac;
        return { x, y };
      }
      
      let idx = phase * (TABLE_SIZE - 1);
      let i = Math.floor(idx);
      let frac = idx - i;
      if (i >= TABLE_SIZE - 1) return { x: audioX[TABLE_SIZE - 1], y: audioY[TABLE_SIZE - 1] };
      const x = audioX[i] * (1 - frac) + audioX[i + 1] * frac;
      const y = audioY[i] * (1 - frac) + audioY[i + 1] * frac;
      return { x, y };
    }
    
    function getAudioTransformedPos(phase) {
      let p = getAudioBasePos(phase);
      // Apply same live transforms as visual (scale, rotate, offset)
      let x = p.x * scaleVal;
      let y = p.y * scaleVal;
      
      // Combined rotation: static angle + continuous rotation from rotateFreq (using dedicated phase)
      let totalRot = rotation + (audioRotatePhase * 2 * Math.PI);
      if (totalRot !== 0) {
        const c = Math.cos(totalRot);
        const s = Math.sin(totalRot);
        const xr = x * c - y * s;
        const yr = x * s + y * c;
        x = xr;
        y = yr;
      }
      
      x += offsetX;
      y += offsetY;

      // Linear master gain + hard safety clamp: what you draw is what you hear.
      // Deliberately no tanh-style saturation — waveshaping would add harmonics
      // the drawn curve doesn't have (a circle must stay a pure sine pair).
      // The clamp only engages when scale/offset push past full scale.
      x = Math.max(-1, Math.min(1, x * AUDIBLE_MASTER));
      y = Math.max(-1, Math.min(1, y * AUDIBLE_MASTER));

      return { x, y };
    }
    
    function simplifyPath(points, tolerance = 0.004) {
      if (points.length <= 2) return points;
      const result = [points[0]];
      for (let i = 1; i < points.length - 1; i++) {
        const prev = result[result.length - 1];
        const curr = points[i];
        if (Math.hypot(curr.x - prev.x, curr.y - prev.y) > tolerance) {
          result.push(curr);
        }
      }
      result.push(points[points.length - 1]);
      return result;
    }
    
    function maybeAutoClosePath() {
      if (!autoClose || currentPath.length < 3) return;
      const first = currentPath[0];
      const last = currentPath[currentPath.length - 1];
      const dist = Math.hypot(first.x - last.x, first.y - last.y);
      if (dist > 0.04) {  // threshold for "open"
        currentPath.push({ x: first.x, y: first.y });  // close it
      }
    }

    // ==================== SHAPE RECOGNITION & AUTODRAW ====================
    function resamplePath(path, N, closed) {
      if (path.length < 2) return path.slice();
      const numSegs = closed ? path.length : path.length - 1;
      let totalLen = 0;
      const segLens = [];
      for (let i = 0; i < numSegs; i++) {
        const ni = closed ? (i + 1) % path.length : i + 1;
