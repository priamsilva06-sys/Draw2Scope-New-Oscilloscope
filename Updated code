<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Draw2Scope</title>
<style>
 @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&amp;display=swap');
  @import url('https://fonts.googleapis.com/css2?family=Press+Start+2P&display=swap');
  
  :root {
    --scope-green: #00ff9f;
    --scope-dark: #0a0f0a;
  }
  
  body {
    margin: 0;
    padding: 0;
    background: linear-gradient(#1a1f1a, #0f120f);
    color: #ddd;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    min-height: 100vh;
  }
  
  .header {
    text-align: center;
    padding: 20px 10px 10px;
    background: #111;
    border-bottom: 3px solid #003322;
  }
  
  h1 {
    font-family: 'Press Start 2P', system-ui;
    font-size: 2.8rem;
    margin: 0 0 8px;
    background: linear-gradient(90deg, #00ff9f, #00cc7a, #00ff9f);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 30px rgba(0, 255, 159, 0.5);
    letter-spacing: 3px;
  }
  
  .subtitle {
    font-size: 1.05rem;
    color: #88aa88;
    margin: 0;
    font-weight: 400;
  }
  
  .main-container {
    display: flex;
    justify-content: center;
    align-items: flex-start;
    gap: 12px;
    padding: 20px 10px;
    flex-wrap: wrap;
  }
  
  .panel {
    background: #111;
    border: 3px solid #334433;
    border-radius: 12px;
    padding: 14px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.6),
                inset 0 1px 0 rgba(255,255,255,0.08);
  }
  
  .panel h3 {
    margin: 0 0 10px;
    font-size: 1.1rem;
    color: #aaddaa;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  
  canvas {
    display: block;
    border-radius: 6px;
    image-rendering: crisp-edges;
  }
  
  #drawCanvas {
    background: #f4f7f4;
    border: 2px solid #556655;
    box-shadow: inset 0 0 15px rgba(0,0,0,0.15);
    cursor: crosshair;
    touch-action: none;
  }
  
  #scopeCanvas {
    background: #0a0f0a;
    border: 4px solid #223322;
    box-shadow: 0 0 30px rgba(0, 40, 20, 0.9),
                inset 0 0 40px rgba(0,0,0,0.7);
    image-rendering: crisp-edges;
  }
  
 #scopeFrame {
   position: relative;
    width: 512px;
    height: 512px;
 }
  
  #scopeHint {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 100%;
    display: none;
    align-items: center;
    justify-content: center;
    pointer-events: none;
    color: #446644;
    font-family: system-ui, monospace;
    font-size: 15px;
    text-align: center;
    white-space: pre-line;
    line-height: 1.5;
    padding: 0 24px;
    box-sizing: border-box;
  }
  
    .freq-column {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 20px 10px;
    background: #0d120d;
    border: 3px solid #334433;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.6);
    margin-top: 42px;
  }
  
  .freq-column h4 {
    margin: 0 0 12px;
    color: #88cc88;
    font-size: 1rem;
    text-align: center;
    letter-spacing: 1px;
  }
  
  .freq-value {
    font-family: 'Press Start 2P', monospace;
    font-size: 1.35rem;
    color: #00ff9f;
    text-shadow: 0 0 12px #00ff9f;
    margin: 4px 0 12px;
    min-width: 110px;
    text-align: center;
  }
  
  input[type="range"] {
    width: 100%;
    accent-color: #00ff9f;
    margin: 6px 0;
  }
  
  input[type="number"] {
    width: 118px;
    background: #1a221a;
    color: #00ff9f;
    border: 2px solid #445544;
    border-radius: 6px;
    padding: 6px 8px;
    font-size: 1.05rem;
    font-family: 'Press Start 2P', monospace;
    text-align: center;
  }
  
  .controls {
    max-width: 1100px;
    margin: 10px auto 30px;
    padding: 16px 20px;
    background: #111;
    border: 3px solid #334433;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.6);
  }
  
  .controls-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
    gap: 16px 24px;
  }
  
  .control-group {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  
  .control-group label {
    font-size: 0.9rem;
    color: #99bb99;
    display: flex;
    align-items: center;
    gap: 6px;
  }
  
  .control-group input[type="range"] {
    width: 100%;
  }
  
  .control-group .value {
    font-family: monospace;
    font-size: 0.85rem;
    color: #66aa66;
    text-align: right;
    min-width: 48px;
  }
  
  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }
  
  .checkbox-row label {
    display: flex;
    align-items: center;
    gap: 6px;
    cursor: pointer;
    font-size: 0.95rem;
    color: #aaddaa;
  }
  
  button {
    background: #223322;
    color: #ccffcc;
    border: 2px solid #445544;
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.9rem;
    cursor: pointer;
    transition: all 0.1s ease;
    font-weight: 500;
  }
  
  button:hover {
    background: #334433;
    border-color: #00ff9f;
    color: #fff;
  }
  
  button:active {
    transform: translateY(1px);
  }

  .shape-btn {
    background: #223322;
    color: #ccffcc;
    border: 1px solid #445544;
    padding: 4px 10px;
    border-radius: 4px;
    font-size: 0.75rem;
    cursor: pointer;
    transition: all 0.1s ease;
  }

  .shape-btn:hover {
    background: #334433;
    border-color: #00ff9f;
  }
  
  .btn-danger {
    border-color: #664444;
    color: #ffaaaa;
  }
  
  .btn-danger:hover {
    background: #442222;
    border-color: #ff6666;
  }
  
  .instructions {
    max-width: 1100px;
    margin: 0 auto 30px;
    padding: 0 20px;
    font-size: 0.9rem;
    color: #779977;
    line-height: 1.5;
  }
  
  .scope-label {
    position: absolute;
    font-family: 'Press Start 2P', monospace;
    font-size: 10px;
    color: #66cc66;
    pointer-events: none;
    text-shadow: 0 0 4px #000;
  }
  .community-wrap {
    max-width: 1100px;
    margin: 0 auto 30px;
    padding: 16px 20px;
    background: #111;
    border: 3px solid #334433;
    border-radius: 12px;
    box-shadow: 0 8px 25px rgba(0,0,0,0.6);
  }
  .community-wrap h2 {
    margin: 0 0 4px;
    font-size: 1.1rem;
    color: #aaddaa;
  }
  .community-sub {
    font-size: 0.82rem;
    color: #668866;
    margin: 0 0 12px;
  }
  .gallery-save-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    align-items: center;
    margin-bottom: 12px;
  }
  .gallery-save-row input {
    flex: 1;
    min-width: 160px;
    background: #1a221a;
    color: #ccffcc;
    border: 2px solid #445544;
    border-radius: 6px;
    padding: 7px 10px;
    font-size: 0.9rem;
  }
  #galleryGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 10px;
  }
  .g-card {
    background: #0d120d;
    border: 2px solid #334433;
    border-radius: 8px;
    padding: 8px;
    text-align: center;
  }
  .g-card canvas {
    width: 100%;
    height: 110px;
    background: #0a0f0a;
    border: 1px solid #223322;
    border-radius: 4px;
  }
  .g-card img {
    width: 100%;
    height: 110px;
    object-fit: cover;
    background: #0a0f0a;
    border: 1px solid #223322;
    border-radius: 4px;
    display: block;
  }
  .g-name {
    font-size: 0.82rem;
    color: #ccffcc;
    margin: 6px 0 2px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .g-meta {
    font-size: 0.72rem;
    color: #668866;
    margin-bottom: 6px;
  }
  .g-btns {
    display: flex;
    gap: 6px;
    justify-content: center;
  }
  .g-btns button {
    font-size: 0.75rem;
    padding: 4px 8px;
  }
  #galleryStatus, #onlineStatus {
    font-size: 0.78rem;
    color: #668866;
    margin-top: 8px;
  }
</style>
</head>
<body>
<script type="text/x-server-plugin">
var VERSION = 2;
var SLOT_START = 8;
var SLOT_SIZE = 576;
var MAX_SLOTS = 400;
var NAME_MAX = 24;
var PTS_MAX = 100;
var THUMB_MAX = 128;
var THUMB_PREFIX = "https://user.uploads.dev/";
var _view = null;
function _v() {
  if (!_view) _view = new DataView(state.buffer, state.byteOffset, state.length);
  return _view;
}
function _init() {
  var v = _v();
  if (v.getUint8(0) !== VERSION) {
    v.setUint8(0, VERSION);
    v.setUint32(1, 1, true);
    for (var s = 0; s < MAX_SLOTS; s++) v.setUint32(SLOT_START + s * SLOT_SIZE, 0, true);
  }
  if (v.getUint32(1, true) < 1) v.setUint32(1, 1, true);
}
function _slotOff(s) { return SLOT_START + s * SLOT_SIZE; }
function _slotCount() {
  var cap = Math.floor((state.length - SLOT_START) / SLOT_SIZE);
  if (cap > MAX_SLOTS) cap = MAX_SLOTS;
  if (cap < 1) cap = 1;
  return cap;
}
function _readSlot(s) {
  var v = _v();
  var o = _slotOff(s);
  var id = v.getUint32(o, true);
  if (!id) return null;
  var likes = v.getUint32(o + 4, true);
  var time = v.getUint32(o + 8, true);
  var nlen = v.getUint8(o + 12);
  if (nlen > 32) nlen = 32;
  var name = "";
  for (var i = 0; i < nlen; i++) {
    var c = v.getUint8(o + 13 + i);
    if (c >= 32 && c < 127) name += String.fromCharCode(c);
  }
  var n = v.getUint16(o + 45, true);
  if (n > PTS_MAX) n = PTS_MAX;
  var pts = [];
  for (var j = 0; j < n; j++) {
    var x = v.getInt16(o + 47 + j * 4, true) / 1000;
    var y = v.getInt16(o + 47 + j * 4 + 2, true) / 1000;
    pts.push([x, y]);
  }
  var tlen = v.getUint8(o + 447);
  if (tlen > THUMB_MAX) tlen = THUMB_MAX;
  var thumb = "";
  for (var k = 0; k < tlen; k++) {
    var tc = v.getUint8(o + 448 + k);
    if (tc >= 32 && tc < 127) thumb += String.fromCharCode(tc);
  }
  if (thumb.slice(0, THUMB_PREFIX.length) !== THUMB_PREFIX) thumb = "";
  return { id: id, name: name, likes: likes, time: time, pts: pts, thumb: thumb };
}
function _writeSlot(s, id, name, likes, time, qpts, thumb) {
  var v = _v();
  var o = _slotOff(s);
  v.setUint32(o, id, true);
  v.setUint32(o + 4, likes, true);
  v.setUint32(o + 8, time, true);
  var nlen = name.length;
  if (nlen > NAME_MAX) nlen = NAME_MAX;
  v.setUint8(o + 12, nlen);
  for (var i = 0; i < 32; i++) {
    var c = i < nlen ? name.charCodeAt(i) : 0;
    if (c < 32 || c > 126) c = 63;
    v.setUint8(o + 13 + i, c);
  }
  var n = qpts.length;
  if (n > PTS_MAX) n = PTS_MAX;
  v.setUint16(o + 45, n, true);
  for (var j = 0; j < PTS_MAX; j++) {
    var x = 0, y = 0;
    if (j < n) { x = qpts[j][0]; y = qpts[j][1]; }
    v.setInt16(o + 47 + j * 4, x, true);
    v.setInt16(o + 47 + j * 4 + 2, y, true);
  }
  if (typeof thumb !== "string") thumb = "";
  if (thumb.length > THUMB_MAX) thumb = thumb.slice(0, THUMB_MAX);
  v.setUint8(o + 447, thumb.length);
  for (var t = 0; t < THUMB_MAX; t++) {
    var chc = t < thumb.length ? thumb.charCodeAt(t) : 0;
    if (chc < 32 || chc > 126) chc = 0;
    v.setUint8(o + 448 + t, chc);
  }
}
function _findById(id) {
  var v = _v();
  var cap = _slotCount();
  for (var s = 0; s < cap; s++) {
    if (v.getUint32(_slotOff(s), true) === id) return s;
  }
  return -1;
}
function _findEmpty() {
  var v = _v();
  var cap = _slotCount();
  for (var s = 0; s < cap; s++) {
    if (v.getUint32(_slotOff(s), true) === 0) return s;
  }
  return -1;
}
function _findOldest() {
  var v = _v();
  var cap = _slotCount();
  var best = -1, bestTime = 4294967295;
  for (var s = 0; s < cap; s++) {
    var id = v.getUint32(_slotOff(s), true);
    if (!id) return s;
    var t = v.getUint32(_slotOff(s) + 8, true);
    if (t < bestTime) { bestTime = t; best = s; }
  }
  return best;
}
var _lastSaveConn = {};
var _lastSaveNet = {};
var _lastLikeConn = {};
var _likedByConn = {};
function _rl(map, key, ms) {
  var now = Date.now();
  var last = map[key] || 0;
  if (now - last < ms) return false;
  map[key] = now;
  // Bound ephemeral rate-limit maps: keys grow with unique conns/nets.
  // Resetting is safe (only allows one extra burst). Checked rarely to stay cheap.
  if (map === _lastSaveNet) {
    // prune oldest when huge (insertion-ordered keys)
    var n = 0;
    for (var kk in map) n++;
    if (n > 5000) {
      var drop = n - 4000;
      for (var k2 in map) { delete map[k2]; if (--drop <= 0) break; }
    }
  }
  return true;
}
function _cleanName(n) {
  if (typeof n !== "string") return null;
  n = n.replace(/^\s+|\s+$/g, "").slice(0, NAME_MAX);
  if (n.length < 1) return null;
  var out = "";
  for (var i = 0; i < n.length; i++) {
    var c = n.charCodeAt(i);
    if (c >= 32 && c < 127) out += n.charAt(i);
  }
  out = out.replace(/^\s+|\s+$/g, "");
  if (!out) return null;
  return out;
}
function _cleanThumb(t) {
  if (typeof t !== "string" || !t) return "";
  if (t.length > THUMB_MAX) return "";
  if (t.slice(0, THUMB_PREFIX.length) !== THUMB_PREFIX) return "";
  for (var i = 0; i < t.length; i++) {
    var c = t.charCodeAt(i);
    if (c < 32 || c > 126) return "";
  }
  return t;
}
self.onopen = function(e) {
  _init();
  e.conn.subscribe("gallery");
};
self.onclose = function(e) {
  delete _lastSaveConn[e.conn.id];
  delete _lastLikeConn[e.conn.id];
  delete _likedByConn[e.conn.id];
};
self.rpc = {
  getPage: function(ctx, data) {
    _init();
    var off = 0, lim = 24;
    try {
      var parts = String(data).split(":");
      off = parseInt(parts[0], 10) || 0;
      lim = parseInt(parts[1], 10) || 24;
    } catch (err) {}
    if (off < 0) off = 0;
    if (lim < 1) lim = 1;
    if (lim > 24) lim = 24;
    var v = _v();
    var cap = _slotCount();
    var all = [];
    for (var s = 0; s < cap; s++) {
      var it = _readSlot(s);
      if (it) all.push(it);
    }
    all.sort(function(a, b) { return b.id - a.id; });
    var total = all.length;
    var slice = all.slice(off, off + lim);
    return JSON.stringify({ total: total, items: slice });
  },
  save: function(ctx, data) {
    _init();
    if (!_rl(_lastSaveConn, ctx.conn.id, 10000)) return JSON.stringify({ ok: false, err: "slow down" });
    var nk = "n" + ctx.conn.net[3];
    if (!_rl(_lastSaveNet, nk, 30000)) return JSON.stringify({ ok: false, err: "slow down" });
    var obj;
    try { obj = JSON.parse(String(data)); } catch (err) { return JSON.stringify({ ok: false, err: "bad json" }); }
    var name = _cleanName(obj && obj.name);
    var pts = obj && obj.pts;
    if (!name) return JSON.stringify({ ok: false, err: "bad name" });
    if (!(pts instanceof Array) || pts.length < 8 || pts.length > PTS_MAX) return JSON.stringify({ ok: false, err: "bad shape" });
    var q = [];
    for (var i = 0; i < pts.length; i++) {
      var p = pts[i];
      if (!(p instanceof Array) || p.length < 2) return JSON.stringify({ ok: false, err: "bad shape" });
      var x = Number(p[0]), y = Number(p[1]);
      if (!isFinite(x) || !isFinite(y) || x < -1.2 || x > 1.2 || y < -1.2 || y > 1.2) return JSON.stringify({ ok: false, err: "bad shape" });
      var xi = Math.round(x * 1000);
      var yi = Math.round(y * 1000);
      if (xi < -1200) xi = -1200; if (xi > 1200) xi = 1200;
      if (yi < -1200) yi = -1200; if (yi > 1200) yi = 1200;
      q.push([xi, yi]);
    }
    var v = _v();
    var id = v.getUint32(1, true);
    v.setUint32(1, id + 1, true);
    var now = Math.floor(Date.now() / 1000);
    var s = _findEmpty();
    if (s < 0) s = _findOldest();
    if (s < 0) return JSON.stringify({ ok: false, err: "full" });
    _writeSlot(s, id, name, 0, now, q, _cleanThumb(obj && obj.thumb));
    var item = _readSlot(s);
    try { pubsub.publish("gallery", JSON.stringify({ t: "add", item: item })); } catch (err) {}
    return JSON.stringify({ ok: true, id: id });
  },
  like: function(ctx, data) {
    _init();
    if (!_rl(_lastLikeConn, ctx.conn.id, 2000)) return JSON.stringify({ ok: false, err: "slow down" });
    var id = parseInt(String(data), 10);
    if (!id || id < 1) return JSON.stringify({ ok: false, err: "bad id" });
    // Per-connection double-click guard (conn ids are ephemeral; onclose drops the whole map,
    // so closed connections can never leak — the old flat "conn:id" keys were never cleaned).
    var seen = _likedByConn[ctx.conn.id];
    if (!seen) { seen = {}; _likedByConn[ctx.conn.id] = seen; }
    if (seen[id]) return JSON.stringify({ ok: false, err: "already liked" });
    seen[id] = 1;
    var s = _findById(id);
    if (s < 0) return JSON.stringify({ ok: false, err: "not found" });
    var v = _v();
    var o = _slotOff(s);
    var likes = v.getUint32(o + 4, true);
    if (likes < 999999) likes++;
    v.setUint32(o + 4, likes, true);
    try { pubsub.publish("gallery", JSON.stringify({ t: "like", id: id, likes: likes })); } catch (err) {}
    return JSON.stringify({ ok: true, likes: likes });
  }
};
</script>
  <div class="header">
    <h1>DRAW2SCOPE</h1>
    <p class="subtitle">Draw a shape • Watch it trace faithfully on the oscilloscope • Hear it in stereo</p>
  </div>

  <div class="main-container">
    <!-- DRAW BOX -->
    <div class="panel">
      <h3>✏️ DRAW BOX</h3>
      <div id="shapeSuggestionBar" style="margin-bottom:10px; padding:8px 10px; background:#1a221a; border:2px solid #00cc7755; border-radius:8px; box-shadow:0 0 10px rgba(0,255,130,0.1);">
        <div style="font-size:0.82rem; color:#88cc88; margin-bottom:6px; display:flex; align-items:center; gap:5px;">
          💡 <span>Did you mean…</span>
        </div>
        <div id="suggestionButtons" style="display:flex; gap:5px; flex-wrap:wrap; justify-content:center;"></div>
      </div>
      <canvas id="drawCanvas" width="420" height="420"></canvas>
      <div style="margin-top: 10px; display: flex; gap: 8px; justify-content: center; flex-wrap: wrap;">
        <button id="clearBtn">Clear Drawing</button>
        <button id="defaultBtn">Load Default Shape</button>
        <button id="lissajousGridBtn" style="background:#334433; border-color:#00cc99;">Lissajous Grid</button>
      </div>
      <div style="margin-top: 8px; display: flex; align-items: center; gap: 8px; justify-content: center; font-size: 0.8rem; color: #88aa88;">
        <span>Draw Line</span>
        <input type="range" id="drawLineSlider" min="1" max="8" step="0.5" value="2.5" style="width: 120px;">
        <span id="drawLineVal">2.5</span>
      </div>
      <div style="margin-top: 8px; text-align: center;">
        <!-- Perfect Drawing button removed - replaced by AutoDraw-style suggestion bar -->
      </div>
    </div>

    <!-- FREQUENCY (between boxes) -->
    <div class="freq-column">
      <h4>⚡ FREQUENCY</h4>
      <div class="freq-value" id="freqValue">60.0 Hz</div>
      
      <div style="width: 100%; padding: 0 4px;">
        <input type="range" id="freqSlider" min="0" max="1000" step="0.1" value="60">
      </div>
      <div style="font-size: 0.7rem; color: #668866; margin-bottom: 4px;">0 — 1000 Hz</div>
      
      <div style="display: flex; align-items: center; gap: 6px; margin-top: 8px;">
        <input type="number" id="freqInput" min="0" max="20000" step="1" value="60">
        <span style="color:#668866; font-size:0.85rem;">Hz</span>
      </div>
      <div style="font-size: 0.65rem; color: #557755; text-align: center; margin-top: 4px; line-height: 1.3;">
