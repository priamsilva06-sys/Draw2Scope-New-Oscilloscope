   // ==================== DRAW CANVAS ====================
   function drawDrawCanvas() {
      if (!drawCtx) return;
      const w = drawCanvas.width;
      const h = drawCanvas.height;
      
      // Background
      drawCtx.fillStyle = '#f4f7f4';
      drawCtx.fillRect(0, 0, w, h);
      
      // Faint grid / cross
      drawCtx.strokeStyle = '#d0d6d0';
      drawCtx.lineWidth = 1;
      drawCtx.beginPath();
      drawCtx.moveTo(w/2, 0);
      drawCtx.lineTo(w/2, h);
      drawCtx.moveTo(0, h/2);
      drawCtx.lineTo(w, h/2);
      drawCtx.stroke();
      
     // Draw committed path (blue)
      // Draw committed strokes (blue) — each stroke separately, no connectors
      if (drawStrokes && drawStrokes.length > 0) {
        drawCtx.strokeStyle = '#0066cc';
        drawCtx.lineWidth = drawLineWidth;
        drawCtx.lineJoin = 'round';
        drawCtx.lineCap = 'round';
        for (const stroke of drawStrokes) {
          if (!stroke || stroke.length < 2) continue;
          drawCtx.beginPath();
          stroke.forEach((pt, i) => {
            const sx = (pt.x * 0.5 + 0.5) * w;
            const sy = (0.5 - pt.y * 0.5) * h;
            if (i === 0) drawCtx.moveTo(sx, sy);
            else drawCtx.lineTo(sx, sy);
          });
          drawCtx.stroke();
        }
      }
      
      // Current stroke in progress (red)
      if (isDrawing && strokePoints.length > 1) {
        drawCtx.strokeStyle = '#dd3300';
        drawCtx.lineWidth = drawLineWidth * 1.3;
        drawCtx.lineJoin = 'round';
        drawCtx.lineCap = 'round';
        drawCtx.beginPath();
        strokePoints.forEach((pt, i) => {
          const sx = (pt.x * 0.5 + 0.5) * w;
          const sy = (0.5 - pt.y * 0.5) * h;
          if (i === 0) drawCtx.moveTo(sx, sy);
          else drawCtx.lineTo(sx, sy);
        });
        drawCtx.stroke();
      }
    }
    
    // ==================== AUDIO ====================
    // Generates the stereo shape signal (X = L, Y = R). Always runs so the scope
    // has a live signal even while the sound is muted — muting happens at the gain node.
    // Single-sample step of the shape voice. Used by the live ScriptProcessor
    // AND by the D2S.renderSamples test hook below, so measurements exercise
    // the exact code path that reaches the speakers.
    function advanceShapeSample(sr) {
      // Sample-accurate phase advance
      audioPhase += currentFreq / sr;
      audioPhase %= 1.0;

      // Advance rotate phase independently (supports negative rotateFreq for opposite direction)
      audioRotatePhase = (((audioRotatePhase + rotateFreq / sr) % 1) + 1) % 1;

      // Advance smooth unbounded osc phase for sinusoidal mode (NO modulo = zero discontinuities)
      audioOscPhase += currentFreq / sr;

      let audioParam = audioPhase;
      if (oscillateMode) {
        // Sinusoidal ping-pong: zero velocity at the turnarounds, so open
        // paths reverse smoothly with no clicks — exactly what the checkbox
        // promises ("slows at ends, reverses direction smoothly"). The output
        // is the true path position at every sample: no smoothing filter.
        const t = audioOscPhase % 1.0;
        audioParam = 0.5 - 0.5 * Math.cos(t * 2 * Math.PI);
      }

      const p = getAudioTransformedPos(audioParam);
      return [p.x, p.y];
    }

    // Scope draw for one 1024-sample block — verbatim dood.al doScriptProcessor
    // scope section: optional sweep remap, Lanczos upsampling, drawLineTexture,
    // then save to oldX/oldY. Reads the live `doodal` controls exactly like the
    // reference reads its `controls`.
    function doodalScopeDraw(xRaw, yRaw) {
      if (!doodalActive || !window.DoodalRender || !window.DoodalFilter || !window.DoodalFilter.K) return;
      const len = xRaw.length;
      for (let i = 0; i < len; i++) {
        scopeX[i] = xRaw[i];
        scopeY[i] = yRaw[i];
      }

      if (doodal.sweepOn && audioCtx) {
        const gain = Math.pow(2.0, doodal.mainGain);
        const sweepMinTime = doodal.sweepMsDiv * 10 / 1000;
        const triggerValue = doodal.sweepTriggerValue;
        const timePerSample = 1 / audioCtx.sampleRate;
        for (let i = 0; i < len; i++) {
          scopeX[i] = sweepPosition / gain;
          sweepPosition += 2 * timePerSample / sweepMinTime;
          if (sweepPosition > 1.1 && belowTrigger && scopeY[i] >= triggerValue)
            sweepPosition = -1.3;
          belowTrigger = scopeY[i] < triggerValue;
        }
      }

      if (!doodal.freezeImage) {
        if (!doodal.disableFilter) {
          window.DoodalFilter.generateSmoothedSamples(scopeOldX, scopeX, scopeSmX);
          window.DoodalFilter.generateSmoothedSamples(scopeOldY, scopeY, scopeSmY);
          if (!doodal.swapXY) window.DoodalRender.drawLineTexture(scopeSmX, scopeSmY);
          else window.DoodalRender.drawLineTexture(scopeSmY, scopeSmX);
        } else {
          if (!doodal.swapXY) window.DoodalRender.drawLineTexture(scopeX, scopeY);
          else window.DoodalRender.drawLineTexture(scopeY, scopeX);
        }
      }

      for (let i = 0; i < len; i++) {
        scopeOldX[i] = scopeX[i];
        scopeOldY[i] = scopeY[i];
      }
    }

    // Mic curve -> scope stereo pair (raw -1..1 in both channels, like a line
    // source; the Hilbert phase-shift option mirrors the previous mono->stereo
    // behaviour). Rendered through the identical doodalScopeDraw path.
    const _micScopeL = new Float32Array(DOODAL_BUFFER);
    const _micScopeR = new Float32Array(DOODAL_BUFFER);
    function doodalMicScopeSamples() {
      const len = DOODAL_BUFFER;
      _micScopeL.fill(0);
      _micScopeR.fill(0);
      if (!micEnabled || !micAnalyser || !micTimeData) return [_micScopeL, _micScopeR];
      micAnalyser.getFloatTimeDomainData(micTimeData);
      const N = micTimeData.length;
      if (micIsStereo && window._micAnalyserR && micTimeDataR) {
        window._micAnalyserR.getFloatTimeDomainData(micTimeDataR);
      }
      const half = Math.floor(N / 2);
      const cosT = Math.cos(micPhase);
      const sinT = Math.sin(micPhase);
      if (micPhase !== 0) {
        computeHilbertFFT(micTimeData, N);
        for (let i = 0; i < len; i++) {
          const j = half + i;
          if (j >= N) break;
          const I = micI[j];
          const Q = micQ[j];
          _micScopeL[i] = I;
          _micScopeR[i] = cosT * I + sinT * Q;
        }
      } else if (micIsStereo && micTimeDataR) {
        for (let i = 0; i < len; i++) {
          const j = half + i;
          if (j >= N) break;
          _micScopeL[i] = micTimeData[j];
          _micScopeR[i] = micTimeDataR[j];
        }
      } else {
        for (let i = 0; i < len; i++) {
          const j = half + i;
          if (j >= N) break;
          const s = micTimeData[j];
          _micScopeL[i] = s;
          _micScopeR[i] = s;
        }
      }
      // Capture the latest raw curve (for freeze-to-draw-box on mic-off)
      if (lastMicLissajous === null) lastMicLissajous = [];
      lastMicLissajous.length = 0;
      const skip = Math.floor(N * 0.12);
      const end = N - skip;
      if (micPhase !== 0) {
        for (let j = skip; j < end; j++) {
          const I = micI[j];
          const Q = micQ[j];
          lastMicLissajous.push({ x: I, y: cosT * I + sinT * Q });
        }
      } else {
        for (let j = skip; j < end; j++) {
          const L = micTimeData[j];
          const R = (micIsStereo && micTimeDataR) ? micTimeDataR[j] : L;
          lastMicLissajous.push({ x: L, y: R });
        }
      }
      return [_micScopeL, _micScopeR];
    }

    function generateScopeSamples(e) {
      const outputL = e.outputBuffer.getChannelData(0);
      const outputR = e.outputBuffer.getChannelData(1);
      const len = outputL.length;

      if (currentPath.length === 0 || !audioCtx) {
        for (let i = 0; i < len; i++) {
          outputL[i] = 0;
          outputR[i] = 0;
        }
        if (micEnabled) {
          const [mL, mR] = doodalMicScopeSamples();
          doodalScopeDraw(mL, mR);
        } else {
          doodalScopeDraw(outputL, outputR);
        }
        return;
      }

      const sr = audioCtx.sampleRate;

      for (let i = 0; i < len; i++) {
        const s = advanceShapeSample(sr);
        outputL[i] = s[0];
        outputR[i] = s[1];
      }
      // The scope taps the same pre-volume samples the speakers play — exactly
      // where dood.al's scopeNode sits (before its audioVolumeNode). Mic mode
      // swaps the scope source to live input, like mic->scopeNode upstream.
      if (micEnabled) {
        const [mL, mR] = doodalMicScopeSamples();
        doodalScopeDraw(mL, mR);
      } else {
        doodalScopeDraw(outputL, outputR);
      }
    }
    
    function initAudio() {
      try {
        audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        scriptNode = audioCtx.createScriptProcessor(1024, 0, 2);
        gainNode = audioCtx.createGain();
        scriptNode.onaudioprocess = generateScopeSamples;
        gainNode.gain.value = 0;
        scriptNode.connect(gainNode);
        gainNode.connect(audioCtx.destination);
      } catch (err) {
        console.warn('Web Audio API not available:', err);
        alert('Sorry, Web Audio is not supported in this browser.');
      }
    }
    
    function updateSoundGain() {
      if (!gainNode) return;
      const slider = document.getElementById('volumeSlider');
      const vol = slider ? parseFloat(slider.value) : 0.6;
      gainNode.gain.value = soundEnabled ? vol : 0;
    }
    
    function enableSound() {
      if (!audioCtx || !scriptNode || !gainNode) {
        initAudio();
      }
      soundEnabled = true;
      updateSoundGain();
      if (audioCtx && audioCtx.state === 'suspended') {
        audioCtx.resume().catch(() => {});
      }
    }
    
    function disableSound() {
      soundEnabled = false;
      updateSoundGain();
    }
    
    // ==================== DOODAL CRT RENDERER ====================

    // Builds the live audio feed and starts the dood.al CRT display.
    // The scope canvas is rendered solely by src/doodal-scope.js (verbatim
    // dood.al pipeline: Lanczos-upsampled gaussian beam -> phosphor fade ->
    // dual blur glow -> exposure/hue/graticule output). The single
    // ScriptProcessor both plays the shape (post-gainNode volume) and draws
    // the identical pre-volume samples — same topology as dood.al's scopeNode.
    function setupDoodalRenderer() {
      initAudio();
      if (!audioCtx || !scriptNode) return false;
      try {
        window.DoodalFilter.init(DOODAL_BUFFER, 8, 6);
        scopeSmX = new Float32Array(window.DoodalFilter.nSmoothedSamples);
        scopeSmY = new Float32Array(window.DoodalFilter.nSmoothedSamples);
        window.DoodalRender.init(scopeCanvas, doodal, {
          bufferSize: DOODAL_BUFFER,
          filterSteps: window.DoodalFilter.steps,
          noiseUrl: 'src/noise.jpg',
          lineSize: doodalLineSize
        });
        window.DoodalRender.setupArrays(window.DoodalFilter.nSmoothedSamples);
        syncScopeSettings();
        requestAnimationFrame(function drawCRTFrame() {
          if (doodalActive) {
            try { window.DoodalRender.drawCRT(); } catch (err) {}
          }
          requestAnimationFrame(drawCRTFrame);
        });
        doodalActive = true;
        resumeAudioOnGesture();
      } catch (err) {
        console.warn('doodal scope unavailable:', err);
        try {
          if (scriptNode) scriptNode.disconnect();
          if (gainNode) gainNode.disconnect();
        } catch (e) {}
        scriptNode = null;
        gainNode = null;
        audioCtx = null;
        doodalActive = false;
        return false;
      }
      return doodalActive;
    }
    
    function resumeAudioOnGesture() {
      const tryResume = () => {
        if (audioCtx && audioCtx.state === 'suspended') {
          audioCtx.resume().catch(() => {});
        }
      };
      tryResume();
      const start = () => {
        tryResume();
        document.removeEventListener('pointerdown', start, true);
        document.removeEventListener('keydown', start, true);
      };
      document.addEventListener('pointerdown', start, true);
      document.addEventListener('keydown', start, true);
    }
    
    // ==================== SCOPE LABELS ====================
    // The trace is rendered entirely by the dood.al CRT pipeline — the only
    // overlays here are the HTML corner labels and the placeholder hint div.
    function updateScopeLabels() {
