      if (modeEl) modeEl.textContent = micEnabled ? 'MIC INPUT' : (sweepMode ? 'SWEEP / YT' : 'XY / LISSAJOUS');
      if (freqEl) freqEl.textContent = micEnabled
        ? (micIsStereo ? 'STEREO IN' : (micPhase === 0 ? 'MONO' : 'STEREO ' + Math.round(micPhase * 180 / Math.PI) + '°'))
