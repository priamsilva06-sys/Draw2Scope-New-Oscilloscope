   function startDrawing(e) {
     isDrawing = true;
     strokePoints = [];
     
     const pos = getPointerPos(e, drawCanvas);
     const norm = getNormPoint(pos.x, pos.y, drawCanvas.width, drawCanvas.height);
     strokePoints.push(norm);
     
     // Suggestion bar stays visible during new drawing
      // Keep existing strokes — only the Clear button clears the drawing.
     drawDrawCanvas();
   }
    
    function continueDrawing(e) {
      if (!isDrawing) return;
      
      const pos = getPointerPos(e, drawCanvas);
      const norm = getNormPoint(pos.x, pos.y, drawCanvas.width, drawCanvas.height);
      
      const last = strokePoints[strokePoints.length - 1];
      const dist = Math.hypot(norm.x - last.x, norm.y - last.y);
      
      if (dist > 0.0035) {  // avoid too many points
        strokePoints.push(norm);
        drawDrawCanvas();
        // Live preview is drawn by the dood.al CRT pipeline at constant
        // frequency speed (independent of mouse movement speed or pauses)
      }
    }
    
   function endDrawing(e) {
     if (!isDrawing) return;
     isDrawing = false;
     
     if (strokePoints.length > 2) {
        // Append — never replace. Earlier strokes stay on the Draw Box.
        const newStroke = simplifyPath(strokePoints);
        const sfp = newStroke[0], slp = newStroke[newStroke.length - 1];
        if (Math.hypot(sfp.x - slp.x, sfp.y - slp.y) < 0.005) newStroke.pop();
        drawStrokes.push(newStroke);
        rebuildScopePathFromStrokes();
     }
     
     strokePoints = [];
     drawDrawCanvas();

      // Show suggestion bar after drawing — only if close matches found.
      // Recognize just the finished stroke so earlier strokes are untouched.
     const suggestionBar = document.getElementById('shapeSuggestionBar');
      const lastStroke = drawStrokes.length > 0 ? drawStrokes[drawStrokes.length - 1] : null;
      if (suggestionBar && lastStroke && lastStroke.length > 2) {
        const suggestions = recognizeShape(lastStroke);
       if (suggestions.length > 0) {
         populateSuggestionBar(suggestions);
         suggestionBar.style.display = 'block';
       } else {
         suggestionBar.style.display = 'none';
       }
     }
   }
    
   // ==================== DEFAULT SHAPE ====================
   function createDefaultPath() {
      pathIsClosed = true;
      const points = 300;
      // Build the circle as a single stroke, then rebuild the scope trace.
      const circle = [];
      for (let i = 0; i < points; i++) {
        const t = (i / points) * Math.PI * 2;
        circle.push({ x: Math.cos(t) * 0.9, y: Math.sin(t) * 0.9 });
      }
      drawStrokes = [circle];
      rebuildScopePathFromStrokes();
   }
    
    // ==================== ANIMATION LOOP ====================
    function startAnimation() {
      if (animationRunning) return;
      animationRunning = true;
      
      function loop() {
        // The dood.al CRT pipeline runs its own RAF loop — this only refreshes
        // the HTML labels and the placeholder hint.
        updateScopeLabels();
        updateScopeHint();
        requestAnimationFrame(loop);
      }
      loop();
    }
    
    // ==================== INITIALIZATION ====================
    function init() {
      drawCanvas = document.getElementById('drawCanvas');
      drawCtx = drawCanvas.getContext('2d', { alpha: true });
      
      scopeCanvas = document.getElementById('scopeCanvas');
      
      // Doodal CRT is the sole renderer of the scope display
      try {
        doodalActive = setupDoodalRenderer();
      } catch (err) {
        doodalActive = false;
        console.warn('doodal scope setup failed:', err);
      }
      if (!doodalActive) {
        const hintEl = document.getElementById('scopeHint');
        if (hintEl) {
          hintEl.textContent = 'WebGL is required for the oscilloscope display — this browser does not support it.';
          hintEl.style.display = 'flex';
        }
      }
      
      // Initial values from sliders (after DOM ready)
      setTimeout(() => {
        updateAllSliders();
        
        // Set initial freq
        const initFreq = 60;
        document.getElementById('freqSlider').value = initFreq;
        document.getElementById('freqInput').value = initFreq;
        currentFreq = initFreq;
        updateFreqDisplay();
        
        // Initial labels
        document.getElementById('persistVal').textContent = document.getElementById('persistSlider').value;
        document.getElementById('brightVal').textContent = document.getElementById('brightSlider').value;
        document.getElementById('rotateVal').textContent = document.getElementById('rotateSlider').value + '°';
        document.getElementById('scaleVal').textContent = parseFloat(document.getElementById('scaleSlider').value).toFixed(2);
        document.getElementById('offsetXVal').textContent = parseFloat(document.getElementById('offsetXSlider').value).toFixed(2);
        document.getElementById('offsetYVal').textContent = parseFloat(document.getElementById('offsetYSlider').value).toFixed(2);
        document.getElementById('traceWidthVal').textContent = parseFloat(document.getElementById('traceWidthSlider').value).toFixed(1);
        document.getElementById('volValue').textContent = parseFloat(document.getElementById('volumeSlider').value).toFixed(2);
        
        // Load a nice default shape so user sees something immediately
        createDefaultPath();
        drawDrawCanvas();
        
        // Show suggestion bar for default shape — only if close matches found
        const suggestions = recognizeShape(currentPath);
        const suggestionBarEl = document.getElementById('shapeSuggestionBar');
        if (suggestions.length > 0) {
          populateSuggestionBar(suggestions);
          if (suggestionBarEl) suggestionBarEl.style.display = 'block';
        } else if (suggestionBarEl) {
          suggestionBarEl.style.display = 'none';
        }
        
        // Default: Sound DISABLED but volume at 100% (user request)
        soundEnabled = false;
        const soundCheckEl = document.getElementById('soundCheck');
        if (soundCheckEl) soundCheckEl.checked = false;
        
        const volSliderEl = document.getElementById('volumeSlider');
        const volValEl = document.getElementById('volValue');
        if (volSliderEl) volSliderEl.value = 1.0;
        if (volValEl) volValEl.textContent = '1.00';
        
        updateSoundGain();

        // Start the magic
        startAnimation();
        
        // Auto-enable a hint (optional - comment out if you want silent start)
        // document.getElementById('soundCheck').checked = true;
        // enableSound();
      }, 80);
      
      attachEventListeners();
      
      // Keyboard shortcut hint (optional)
      document.addEventListener('keydown', (e) => {
        if (!e.key) return;
        if (e.key.toLowerCase() === '?' && document.activeElement.tagName === 'BODY') {
          const help = 'Draw2Scope shortcuts:\n' +
                       '• Draw with mouse/touch in left box\n' +
                       '• Press C to clear drawing\n' +
                       '• Press D for default shape\n' +
                       '• Press R to reset transforms';
          alert(help);
        }
       if (e.key.toLowerCase() === 'c') {
         currentPath = [];
          drawStrokes = [];
         pathIsClosed = false;
         strokePoints = [];
         isDrawing = false;
         drawDrawCanvas();
       }
        if (e.key.toLowerCase() === 'd') {
          createDefaultPath();
          drawDrawCanvas();
        }
        if (e.key.toLowerCase() === 'r') {
          document.getElementById('resetTransBtn').click();
        }
      });
      
      // Easter egg: click title to randomize a cool shape
      const title = document.querySelector('h1');
      if (title) {
        title.style.cursor = 'pointer';
       title.addEventListener('click', () => {
          const randPts = [];
         const n = 220 + Math.floor(Math.random() * 120);
         const harmonics = 1 + Math.floor(Math.random() * 4);
         for (let i = 0; i < n; i++) {
           const t = (i / n) * Math.PI * 2;
           const x = Math.sin(t * harmonics) * (0.6 + Math.random() * 0.35);
           const y = Math.cos(t * (harmonics + 1)) * (0.6 + Math.random() * 0.35) + Math.sin(t * 0.5) * 0.2;
            randPts.push({ x: x * 0.95, y: y * 0.95 });
         }
          drawStrokes = [randPts];
          rebuildScopePathFromStrokes();
         drawDrawCanvas();
       });
      }
      
      console.log('%c[Draw2Scope] Initialized successfully. Ready to draw!', 'color:#448844');
    }
    
    // Public bridge for the gallery section (separate <script> block):
    // getPath/setPath go through the live dood.al CRT audio + render pipeline.
   window.D2S = {
     getPath: () => currentPath,
     setPath: (pts) => {
        const strokeCopy = pts.map(p => ({ x: p.x, y: p.y }));
        const traceCopy = pts.map(p => ({ x: p.x, y: p.y }));
        drawStrokes = [strokeCopy];
        const f = traceCopy[0], l = traceCopy[traceCopy.length - 1];
        pathIsClosed = Math.hypot(f.x - l.x, f.y - l.y) < 0.05;
        currentPath = traceCopy;
        drawDrawCanvas();
        updateAudioBuffer();
      },
      renderSamples: (n) => {
        const sr = audioCtx ? audioCtx.sampleRate : 48000;
        const L = new Float32Array(n), R = new Float32Array(n);
        const sp = audioPhase, srp = audioRotatePhase, sop = audioOscPhase;
        for (let i = 0; i < n; i++) {
          const s = advanceShapeSample(sr);
          L[i] = s[0]; R[i] = s[1];
        }
        audioPhase = sp; audioRotatePhase = srp; audioOscPhase = sop;
        return { L: Array.from(L), R: Array.from(R), sr };
      }
    };

    // Boot
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  </script>
  <script>
    (function() {
      try {
        if (window.root && root.commentsPlugin) {
          document.getElementById('commentsCtn').innerHTML = root.commentsPlugin({
            channel: "draw2scope-comments",
            width: "100%",
            height: 350,
            commentPlaceholderText: "Share a tip or favourite shape…",
            newestCommentsAtTop: true
          });
        }
      } catch (e) { console.warn("comments failed", e); }

      var grid = document.getElementById('galleryGrid');
      var status = document.getElementById('galleryStatus');
      var onlineEl = document.getElementById('onlineStatus');
      var nameInput = document.getElementById('galleryNameInput');
      var socket = null;
      var retryDelay = 1000;
      var cache = {};

      function setStatus(t) { if (status) status.textContent = t; }

      function drawThumb(canvas, pts) {
        var ctx = canvas.getContext('2d');
        var W = canvas.width = 150, H = canvas.height = 110;
        ctx.fillStyle = '#0a0f0a';
        ctx.fillRect(0, 0, W, H);
        ctx.strokeStyle = '#00ff9f';
        ctx.lineWidth = 1.5;
        ctx.shadowColor = '#00ff9f';
        ctx.shadowBlur = 4;
        ctx.beginPath();
        for (var i = 0; i < pts.length; i++) {
          var px = W / 2 + pts[i][0] * W * 0.44;
          var py = H / 2 - pts[i][1] * H * 0.44;
          if (i === 0) ctx.moveTo(px, py); else ctx.lineTo(px, py);
        }
        ctx.stroke();
      }

      function thumbEl(it) {
        if (it.thumb && it.thumb.indexOf('https://user.uploads.dev/') === 0) {
          var img = document.createElement('img');
          img.src = it.thumb;
          img.alt = '';
          img.loading = 'lazy';
          img.onerror = function() {
            var c = document.createElement('canvas');
            drawThumb(c, it.pts);
            img.replaceWith(c);
          };
          return img;
        }
        var c2 = document.createElement('canvas');
        drawThumb(c2, it.pts);
        return c2;
      }

      async function captureScopeThumb() {
        var src = document.getElementById('scopeCanvas');
        if (!src || !src.width) return '';
        var c = document.createElement('canvas');
        c.width = 150; c.height = 110;
        var ctx = c.getContext('2d');
        ctx.fillStyle = '#000';
        ctx.fillRect(0, 0, 150, 110);
        var sa = src.width / src.height, ta = 150 / 110;
        var sw, sh, sx, sy;
        if (sa > ta) { sh = src.height; sw = sh * ta; sx = (src.width - sw) / 2; sy = 0; }
        else { sw = src.width; sh = sw / ta; sx = 0; sy = (src.height - sh) / 2; }
        ctx.drawImage(src, sx, sy, sw, sh, 0, 0, 150, 110);
        try {
          var px = ctx.getImageData(0, 0, 150, 110).data;
          var lit = 0;
          for (var p = 0; p < px.length; p += 16) {
            if (px[p] + px[p + 1] + px[p + 2] > 60 && ++lit > 25) break;
          }
          if (lit <= 25) return '';
        } catch (e) { return ''; }
        var blob = await new Promise(function(res) { c.toBlob(res, 'image/jpeg', 0.72); });
        if (!blob) return '';
        var up = await root.uploadPlugin(blob);
        if (!up || up.error || !up.url) return '';
        return up.url;
      }

      function esc(s) {
        return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
      }

      function renderItems(items) {
        grid.innerHTML = '';
        if (!items.length) {
          grid.innerHTML = '<div style="color:#557755;font-size:0.85rem;">No shared shapes yet — be the first!</div>';
          return;
        }
        items.forEach(function(it) {
          cache[it.id] = it;
          var card = document.createElement('div');
          card.className = 'g-card';
          card.appendChild(thumbEl(it));
          var nm = document.createElement('div');
          nm.className = 'g-name';
          nm.textContent = it.name;
          card.appendChild(nm);
          var meta = document.createElement('div');
          meta.className = 'g-meta';
          meta.innerHTML = '♥ <span>' + it.likes + '</span>';
          card.appendChild(meta);
          var btns = document.createElement('div');
          btns.className = 'g-btns';
          var load = document.createElement('button');
          load.textContent = 'Load';
          load.onclick = function() { loadItem(it.id); };
          var like = document.createElement('button');
          like.textContent = '♥ Like';
          like.onclick = function() { likeItem(it.id, card); };
          btns.appendChild(load);
          btns.appendChild(like);
          card.appendChild(btns);
          grid.appendChild(card);
        });
      }

      function loadItem(id) {
        var it = cache[id];
        if (!it || !it.pts || it.pts.length < 2) return;
        try {
          window.D2S.setPath(it.pts.map(function(p) { return { x: p[0], y: p[1] }; }));
          setStatus('Loaded "' + it.name + '" to your scope.');
          document.getElementById('drawCanvas').scrollIntoView({ behavior: 'smooth', block: 'center' });
        } catch (e) { setStatus('Could not load shape.'); }
      }

      function likeItem(id, card) {
        if (!socket || socket.readyState !== 1) { setStatus('Not connected yet.'); return; }
        socket.rpc.like(String(id)).then(function(raw) {
          var r;
          try { r = JSON.parse(raw); } catch (e) { return; }
          if (r.ok) {
            var s = card.querySelector('.g-meta span');
            if (s) s.textContent = r.likes;
            if (cache[id]) cache[id].likes = r.likes;
          } else if (r.err) setStatus(r.err);
        }).catch(function() {});
      }

      function fetchPage() {
        if (!socket || socket.readyState !== 1) return;
        setStatus('Loading gallery…');
        socket.rpc.getPage("0:24").then(function(raw) {
          var r;
          try { r = JSON.parse(raw); } catch (e) { setStatus('Gallery parse error.'); return; }
          renderItems(r.items || []);
          setStatus((r.total || 0) + ' shared shape' + ((r.total || 0) === 1 ? '' : 's') + '.');
        }).catch(function() { setStatus('Gallery unavailable.'); });
      }

      document.getElementById('refreshGalleryBtn').onclick = fetchPage;
      document.getElementById('saveToGalleryBtn').onclick = async function() {
        if (!socket || socket.readyState !== 1) { setStatus('Not connected yet.'); return; }
        var live = window.D2S ? window.D2S.getPath() : [];
        if (!live || live.length < 8) { setStatus('Draw something first (8+ points).'); return; }
        var name = (nameInput.value || '').trim() || 'Untitled';
        var step = Math.max(1, Math.floor(live.length / 100));
        var pts = [];
        for (var i = 0; i < live.length && pts.length < 100; i += step) {
          pts.push([+live[i].x.toFixed(3), +live[i].y.toFixed(3)]);
        }
        setStatus('Capturing scope…');
        var thumb = '';
        try { thumb = await captureScopeThumb(); } catch (e) { thumb = ''; }
        setStatus('Sharing…');
        try {
          var raw = await socket.rpc.save(JSON.stringify({ name: name.slice(0, 24), pts: pts, thumb: thumb }));
          var r;
          try { r = JSON.parse(raw); } catch (e) { setStatus('Share failed.'); return; }
          if (r.ok) { setStatus('Shared!'); nameInput.value = ''; fetchPage(); }
          else setStatus(r.err || 'Share failed.');
        } catch (e) { setStatus('Share failed.'); }
      };

     function connect() {
       try {
         socket = root.createServerSocket();
       } catch (e) { setStatus('Gallery unavailable.'); return; }
       socket.addEventListener('open', function() {
         retryDelay = 1000;
         fetchPage();
          if (onlineEl) onlineEl.textContent = '● Connected';
       });
       socket.addEventListener('message', function(ev) {
         try {
           var m = JSON.parse(ev.data);
           if (m.t === 'like' && cache[m.id]) {
             cache[m.id].likes = m.likes;
             fetchPage();
           } else if (m.t === 'add') fetchPage();
         } catch (e) {}
       });
       socket.addEventListener('close', function(ev) {
         if (ev.code === 4403) { setStatus('Gallery unavailable off perchance.org.'); return; }
         setStatus('Reconnecting…');
          if (onlineEl) onlineEl.textContent = '○ Reconnecting…';
         setTimeout(connect, retryDelay);
         retryDelay = Math.min(retryDelay * 2, 30000);
       });
     }
     if (window.root && root.createServerSocket) connect();
     else setStatus('Gallery unavailable.');
    })();
  </script>
