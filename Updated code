    // ==================== LISSAJOUS GRID (was dead UI: button had no handler) ====================
    function lissajousPath(a, b, phase) {
      const pts = [];
      const n = 256;
      const ph = (phase === undefined) ? Math.PI / 2 : phase;
      for (let i = 0; i < n; i++) {
        const t = (i / n) * Math.PI * 2;
        pts.push({ x: Math.sin(a * t + ph) * 0.8, y: Math.sin(b * t) * 0.8 });
      }
      return pts;
    }
    function populateLissajousGrid() {
      const grid = document.getElementById('lissajousGrid');
      if (!grid || grid.children.length > 0) return;
      const ratios = [[1,1],[1,2],[2,1],[1,3],[3,1],[2,3],[3,2],[3,4],[4,3],[3,5],[5,3],[4,5]];
      ratios.forEach(function(rb) {
        const a = rb[0], b = rb[1];
        const card = document.createElement('div');
        card.style.cssText = 'background:#0d120d;border:2px solid #334433;border-radius:8px;padding:8px;text-align:center;cursor:pointer;';
        const cv = document.createElement('canvas');
