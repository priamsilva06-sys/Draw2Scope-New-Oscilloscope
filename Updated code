    // ==================== MICROPHONE MODE ====================
    async function enableMic() {
      try {
        if (!audioCtx) {
          audioCtx = new (window.AudioContext || window.webkitAudioContext)();
        }
        if (audioCtx.state === 'suspended') await audioCtx.resume();
        micStream = await navigator.mediaDevices.getUserMedia({ audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, channelCount: 2 } });
        const source = audioCtx.createMediaStreamSource(micStream);
        // Detect true stereo input
        const track = micStream.getAudioTracks()[0];
        micIsStereo = track && track.getSettings && track.getSettings().channelCount === 2;
        
        if (micIsStereo) {
          // Split L and R into separate analysers
          const splitter = audioCtx.createChannelSplitter(2);
          source.connect(splitter);
          micAnalyser = audioCtx.createAnalyser();
          micAnalyser.fftSize = 2048;
          micAnalyser.smoothingTimeConstant = 0;
          splitter.connect(micAnalyser, 0);
          const micAnalyserR = audioCtx.createAnalyser();
          micAnalyserR.fftSize = 2048;
          micAnalyserR.smoothingTimeConstant = 0;
          splitter.connect(micAnalyserR, 1);
          // Zero-gain sink to pull data through
          const micGain = audioCtx.createGain();
          micGain.gain.value = 0;
          micAnalyser.connect(micGain);
          micAnalyserR.connect(micGain);
          micGain.connect(audioCtx.destination);
          window._micAnalyserR = micAnalyserR;
          micTimeData = new Float32Array(micAnalyser.fftSize);
          micTimeDataR = new Float32Array(micAnalyserR.fftSize);
        } else {
          micAnalyser = audioCtx.createAnalyser();
          micAnalyser.fftSize = 2048;
          micAnalyser.smoothingTimeConstant = 0;
          source.connect(micAnalyser);
          const micGain = audioCtx.createGain();
          micGain.gain.value = 0;
          micAnalyser.connect(micGain);
          micGain.connect(audioCtx.destination);
          micTimeData = new Float32Array(micAnalyser.fftSize);
          micTimeDataR = null;
          window._micAnalyserR = null;
        }
        micEnabled = true;
        lastMicLissajous = null; // fresh capture
      } catch(err) {
        console.warn('Microphone access denied:', err);
        const micCheck = document.getElementById('micCheck');
        if (micCheck) micCheck.checked = false;
        alert('Could not access microphone: ' + err.message);
      }
    }
    
    function disableMic() {
      micEnabled = false;
      if (micStream) {
        micStream.getTracks().forEach(t => t.stop());
        micStream = null;
      }
      micAnalyser = null;
      micTimeDataR = null;
      micIsStereo = false;
      window._micAnalyserR = null;

      // Freeze the last Lissajous curve onto the Draw Box so the user can
      // adjust frequency / transforms for it as if it had just been drawn.
      if (lastMicLissajous && lastMicLissajous.length > 4) {
        // Normalize: scale the captured points to fill the draw box nicely
        let maxAbs = 0;
        for (const p of lastMicLissajous) {
          if (Math.abs(p.x) > maxAbs) maxAbs = Math.abs(p.x);
          if (Math.abs(p.y) > maxAbs) maxAbs = Math.abs(p.y);
        }
       if (maxAbs < 0.0001) maxAbs = 1; // avoid divide-by-zero for silent input
       const scaleUp = 0.9 / maxAbs;
        const frozen = lastMicLissajous.map(p => ({ x: p.x * scaleUp, y: p.y * scaleUp }));
        const ffp = frozen[0], llp = frozen[frozen.length - 1];
        if (Math.hypot(ffp.x - llp.x, ffp.y - llp.y) < 0.005) frozen.pop();
        drawStrokes = [frozen];
        rebuildScopePathFromStrokes();
        drawDrawCanvas();

        // Show shape suggestions for the frozen curve
        const suggestionBar = document.getElementById('shapeSuggestionBar');
        if (suggestionBar && frozen.length > 2) {
          const suggestions = recognizeShape(frozen);
          if (suggestions.length > 0) {
            populateSuggestionBar(suggestions);
            suggestionBar.style.display = 'block';
          } else {
            suggestionBar.style.display = 'none';
          }
        }
      }
      lastMicLissajous = null;
    }
    
